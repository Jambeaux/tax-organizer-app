# Copy to .env.local and fill in real values (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of JLB Tax staff emails — anyone signing in with
# one of these gets access to /staff instead of the client dashboard.
STAFF_EMAILS=

# Cloudflare Turnstile CAPTCHA on the sign-in form (blocks bots/spam
# signups). Get a site key + secret key from a free Cloudflare account
# (dash.cloudflare.com > Turnstile). Put the SITE key here; put the
# SECRET key in Supabase's dashboard under Authentication > Attack
# Protection > enable CAPTCHA protection > Turnstile. If this is left
# blank, the sign-in form works with no CAPTCHA at all (fine for local
# dev, not recommended for production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

DROPBOX_SIGN_MODE=test
DROPBOX_SIGN_TEST_KEY=
DROPBOX_SIGN_LIVE_KEY=

SQUARE_MODE=test
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_SIGNATURE_KEY=
SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_SIGNATURE_KEY=

# SMTP mailbox used to send staff notification emails (new tax organizer
# submission, new document upload) — reuses the same SiteGround webmail
# mailbox already set up as Supabase Auth's custom SMTP provider. If left
# blank, notifications are skipped (logged, not sent) rather than
# breaking the client-facing action that triggered them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
